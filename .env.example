# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection
# Get this from MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Configuration
# Use strong, random strings for production
JWT_SECRET=your-super-strong-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-strong-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
# Max requests per 15 mins for a single IP
RATE_LIMITER_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info